# Konfigurasi Database Prisma (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret Key untuk Enkripsi Token JWT Login Admin (Ganti dengan string acak panjang di production)
