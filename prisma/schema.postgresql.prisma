generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  imageUrl     String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  showOnHome   Boolean   @default(true)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  shortDescription String?
  description      String
  price            Float
  promoPrice       Float?
  sku              String?
  unit             String           @default("pcs")
  stock            Int              @default(10)
  minStockAlert    Int              @default(5)
  isAvailable      Boolean          @default(true)
  isBestSeller     Boolean          @default(false)
  isFeatured       Boolean          @default(false)
  isNew            Boolean          @default(false)
  showOnHome       Boolean          @default(true)
  displayOrder     Int              @default(0)
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  ingredients      String?
  allergens        String?
  storageGuide     String?
  shelfLife        String?
  weightGrams      Float?
  piecesPerPack    Int?             @default(1)
  seoTitle         String?
  seoDesc          String?
  images           ProductImage[]
  variants         ProductVariant[]
  orderItems       OrderItem[]
  galleryItems     GalleryItem[]
  stockLogs        StockLog[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  alt          String?
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  priceAdjustment Float    @default(0)
  stock           Int      @default(10)
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model GalleryItem {
  id           String   @id @default(cuid())
  title        String
  category     String   @default("Kue Basah")
  imageUrl     String
  caption      String?
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderCode       String      @unique
  customerName    String
  customerPhone   String
  fulfillmentType String      @default("PICKUP")
  deliveryAddress String?
  scheduleDate    String?
  scheduleTime    String?
  notes           String?
  paymentMethod   String?     @default("QRIS_GOPAY")
  status          String      @default("MENUNGGU_KONFIRMASI")
  paymentStatus   String      @default("BELUM_DIVERIFIKASI")
  subtotal        Float
  shippingFee     Float       @default(0)
  discount        Float       @default(0)
  totalAmount     Float
  adminNotes      String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  variantName String?
  unitPrice   Float
  quantity    Int
  subtotal    Float
}

model StockLog {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  changeAmount  Int
  previousStock Int
  newStock      Int
  reason        String
  createdAt     DateTime @default(now())
}

model StoreSetting {
  id                 String   @id @default("default")
  brandName          String   @default("Dapur Rasa")
  tagline            String   @default("Kue & Camilan Rumahan Kualitas Premium")
  logoUrl            String?
  faviconUrl         String?
  whatsappNumber     String   @default("6285888159765")
  address            String?  @default("Perum Griya Cileungsi 5, Cileungsi, Bogor")
  operationalHours   String   @default("Senin - Minggu: 06:00 - 18:00 WIB")
  fulfillmentOptions String   @default("PICKUP,DELIVERY")
  defaultShippingFee Float    @default(10000)
  minOrderAmount     Float    @default(0)
  currency           String   @default("IDR")
  timezone           String   @default("Asia/Jakarta")
  instagramUrl       String?
  facebookUrl        String?
  tiktokUrl          String?
  metaTitle          String?  @default("Dapur Rasa | Aneka Kue & Camilan Rumahan Lezat")
  metaDescription    String?  @default("Pesan aneka kue basah, pastel, risol, bolu, dan snack box lezat khas rumahan dengan bahan premium.")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ThemeConfig {
  id                 String   @id @default("default")
  primaryColor       String   @default("#4B291B")
  secondaryColor     String   @default("#A9683B")
  backgroundColor    String   @default("#FAF5EF")
  surfaceColor       String   @default("#FFFDF9")
  accentColor        String   @default("#EBD9C7")
  textColor          String   @default("#211A16")
  successColor       String   @default("#287A49")
  errorColor         String   @default("#B42318")
  fontFamilyHeading  String   @default("serif")
  fontFamilyBody     String   @default("sans")
  borderRadius       String   @default("rounded-xl")
  buttonShape        String   @default("rounded-lg")
  updatedAt          DateTime @updatedAt
}

model HomepageSection {
  id                  String   @id @default(cuid())
  sectionKey          String   @unique
  title               String
  subtitle            String?
  description         String?
  imageUrl            String?
  mobileImageUrl      String?
  buttonText          String?
  buttonLink          String?
  secondaryButtonText String?
  secondaryButtonLink String?
  badgeText           String?
  isEnabled           Boolean  @default(true)
  displayOrder        Int      @default(0)
  customConfig        String?
  updatedAt           DateTime @updatedAt
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  coverImage  String?
  category    String   @default("Resep & Tips")
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  authorName  String   @default("Admin Dapur Rasa")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  customerRole String?  @default("Pelanggan Setia")
  rating       Int      @default(5)
  reviewText   String
  avatarUrl    String?
  isFeatured   Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FaqItem {
  id           String   @id @default(cuid())
  question     String
  answer       String
  category     String   @default("Umum")
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PromotionalPopup {
  id          String   @id @default("default")
  isEnabled   Boolean  @default(false)
  title       String?  @default("Promo Spesial Hari Ini!")
  description String?
  imageUrl    String?
  buttonText  String?  @default("Lihat Promo")
  buttonLink  String?  @default("/produk")
  updatedAt   DateTime @updatedAt
}
